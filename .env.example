# Public origin of the live site. Used to build absolute canonical and
# hreflang URLs for multilingual SEO. Set this to the production domain (no
# trailing slash); local builds fall back to a placeholder.
NEXT_PUBLIC_SITE_URL=https://www.loslagoshotel.com.ar

# ── Analytics (optional; each tracker is independent, nothing loads until set) ─
# The same events (book_click, book_intent, contact_click) plus page views are
# sent to whichever of these is configured — run either, both, or neither.
#
# PostHog — product analytics: funnel, session replay, heatmaps, A/B testing.
# Project API key from PostHog → Settings → Project.
#NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PostHog API host. Defaults to US Cloud; use https://eu.i.posthog.com for EU
# data residency, or your self-hosted URL.
#NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Google Analytics 4 — acquisition / SEO / ads attribution. Measurement ID from
# GA4 → Admin → Data Streams → your web stream.
#NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

NEXT_PUBLIC_CLOUDBEDS_PROPERTY_CODE=5fdNYA
NEXT_PUBLIC_CLOUDBEDS_ISLAND=us2
NEXT_PUBLIC_BASE_CURRENCY=ARS
NEXT_PUBLIC_DISPLAY_CURRENCY=USD

# Cloudbeds API credentials used only by the server-side bedding-availability
# endpoint. Never prefix the API key with NEXT_PUBLIC_ or commit it. Rotate any
# key that has appeared in a screenshot, chat, ticket or client-side bundle.
CLOUDBEDS_PROPERTY_ID=226132923101312
#CLOUDBEDS_API_KEY=replace-with-a-rotated-server-only-key
# Shared secret required by /api/cloudbeds/reservation-created. Configure the
# Cloudbeds webhook URL as:
# https://your-domain.example/api/cloudbeds/reservation-created?secret=<secret>
#CLOUDBEDS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Argentine VAT (IVA) rate applied to lodging. Argentine residents pay it;
# residents abroad are exempt (Decreto 1043/2016).
NEXT_PUBLIC_VAT_RATE=0.21

# ── FX rate policy (server-side; all optional, sensible defaults) ────────────
# Upstream endpoint for the live USD->ARS rate.
#FX_RATE_URL=https://bvdlrnvwjzizrjvimisa.supabase.co/functions/v1/latest-confirmed-fx-rate
# Sanity band: rates outside [min, max] are rejected (defaults 200 / 100000).
#FX_RATE_MIN=200
#FX_RATE_MAX=100000
# Rates older than this are served flagged `stale: true` (default 48).
#FX_RATE_MAX_AGE_HOURS=48
# Rates older than this are rejected outright (default 168 = 7 days).
#FX_RATE_HARD_MAX_AGE_HOURS=168

# Client-side FX diagnostics beacon (off by default; set "on" to enable).
#NEXT_PUBLIC_FX_DIAGNOSTICS=off

# Internal names (Nombre interno -> input `name`) of the Cloudbeds booking-engine
# custom fields used to record the FX snapshot on each reservation. NOT the
# display title. The app matches by `name`/`data-testid`, auto-fills and hides
# them, so the display title can be anything.
NEXT_PUBLIC_CB_FIELD_FX_RATE=cf_fx_ars_usd
NEXT_PUBLIC_CB_FIELD_PRICE_NO_VAT_ARS=cf_precio_sin_iva_ars
NEXT_PUBLIC_CB_FIELD_PRICE_NO_VAT_USD=cf_precio_sin_iva_usd
NEXT_PUBLIC_CB_FIELD_VAT_ARS=cf_iva_ars
NEXT_PUBLIC_CB_FIELD_VAT_USD=cf_iva_usd
NEXT_PUBLIC_CB_FIELD_PRICE_ARS=cf_precio_ars_con_iva
NEXT_PUBLIC_CB_FIELD_PRICE_USD=cf_precio_usd_con_iva
# Comfiar "Factura T" flag: "SI" = IVA-exempt resident abroad, "NO" = resident.
# Reuse Comfiar's existing custom field; set this to its internal name.
NEXT_PUBLIC_CB_FIELD_FACTURA_T=cf_factura_t
# Hidden Cloudbeds booking-engine custom field that stores the selected bedding
# distribution for server-side physical-room assignment.
NEXT_PUBLIC_CB_FIELD_BEDDING_PREFERENCE=cf_bedding_preference
